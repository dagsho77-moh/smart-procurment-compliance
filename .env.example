# Which LLM backend to use: github | ollama | mock
#   github -> GitHub Models free tier (needs GITHUB_TOKEN)
#   ollama -> local models via Ollama's OpenAI-compatible API
#   mock   -> deterministic, offline; replays synthetic ground truth (tests / demos)
LLM_PROVIDER=github

# Fine-grained personal access token with the "Models" (read) permission
GITHUB_TOKEN=

# Optional overrides (defaults live in config/settings.yaml)
# GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
# VISION_MODEL=openai/gpt-4o-mini
# TEXT_MODEL=openai/gpt-4o-mini
# OLLAMA_ENDPOINT=http://localhost:11434/v1
# OLLAMA_VISION_MODEL=llama3.2-vision
# OLLAMA_TEXT_MODEL=llama3.2-vision
